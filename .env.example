# Public site URL (used for canonical/sitemap/OG)
NEXT_PUBLIC_SITE_URL="https://bestscreentester.com"

# Contact address used by the feedback/contact page (mailto link)
NEXT_PUBLIC_CONTACT_EMAIL="hello+bestscreentester@nelera.com"

# Google Analytics 4 Measurement ID. Defaults to the site's ID in code; only set
# this to override (e.g. a separate staging property).
NEXT_PUBLIC_GA_ID=""

# Search-engine verification tokens — both OPTIONAL and normally empty.
# Google Search Console is verified as a Domain property via a DNS TXT record, and
# Bing Webmaster Tools is already verified, so neither meta tag needs to ship. Set
# these only if a verification has to be re-established via the HTML-tag method.
# In CI they come from repo *variables* (not secrets): a verification token is public
# by design, and any NEXT_PUBLIC_* value ends up in the client bundle anyway.
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# IndexNow is wired in CI (.github/workflows/ci.yml -> scripts/indexnow.mjs), not here.
# The key is public and lives at /<key>.txt in public/ — that is how the protocol
# proves domain ownership, so it is not a secret.
